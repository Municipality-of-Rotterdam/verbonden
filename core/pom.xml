<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.rotterdam.verbonden</groupId>
        <artifactId>verbonden</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>verbonden-core</artifactId>
    <packaging>jar</packaging>

    <name>verbonden-core</name>
    <description>
        Gedeelde productiecode en publiek SPI-contract (package `identity`) voor de
        Verbonden-applicatie van Gemeente Rotterdam. Niet zelfstandig start-baar;
        vereist een adapter-module zoals verbonden-remote-local.
    </description>
    <!-- Deliberately duplicated (not inherited) from the parent pom: Maven's default
         inheritance appends this module's artifactId to an inherited url/scm.* (e.g.
         ".../verbonden/verbonden-core"), which is wrong here since every module lives
         at the same repo URL. The documented opt-out (child.*.inherit.append.path
         properties, either on parent or child) does not take effect on this project's
         Maven version (verified empirically, incl. in an isolated throwaway reactor),
         so an explicit, identical copy is the only reliable way to publish a correct
         url/scm to Maven Central. Keep this in sync with pom.xml/remote-local/pom.xml
         if the repo URL ever changes. -->
    <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>

    <scm>
        <connection>scm:git:https://github.com/Municipality-of-Rotterdam/verbonden.git</connection>
        <developerConnection>scm:git:git@github.com:Municipality-of-Rotterdam/verbonden.git</developerConnection>
        <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>
    </scm>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wicketstuff</groupId>
            <artifactId>wicketstuff-minis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache Wicket -->
        <dependency>
            <groupId>org.apache.wicket</groupId>
            <artifactId>wicket-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.wicket</groupId>
            <artifactId>wicket-spring</artifactId>
        </dependency>

        <!-- NL Design System Wicket Components by Rotterdam -->
        <dependency>
            <groupId>nl.rotterdam.nl-design-system</groupId>
            <artifactId>rotterdam-nlds-wicket</artifactId>
        </dependency>
        <!-- Rotterdam Design Tokens (rods-theme CSS custom properties) -->
        <dependency>
            <groupId>nl.rotterdam.nl-design-system</groupId>
            <artifactId>rotterdam-nlds-css-wicket</artifactId>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Provides ClientRegistrationRepository/.oauth2Login(...) for the composable
             burgerSecurityFilterChain; no OIDC provider is configured within this repo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- Flyway database migrations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Phone number validation -->
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
        </dependency>

        <!-- Email address validation -->
        <dependency>
            <groupId>commons-validator</groupId>
            <artifactId>commons-validator</artifactId>
        </dependency>

        <!-- ZXing QR code generation -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <!-- Jsoup for web scraping (BABS import from rotterdam.nl) -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <!-- Apache POI for xlsx import -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Wicket Webjars integration -->
        <dependency>
            <groupId>de.agilecoders.wicket.webjars</groupId>
            <artifactId>wicket-webjars</artifactId>
        </dependency>
        <!-- Bootstrap utilities CSS (via WebJars) -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>bootstrap</artifactId>
        </dependency>

        <!-- Wicket Extensions (for DataTable toolbars) -->
        <dependency>
            <groupId>org.apache.wicket</groupId>
            <artifactId>wicket-extensions</artifactId>
        </dependency>

        <!-- Rotterdam NLDS Extensions (RotterdamLogoImage, icons, etc.) -->
        <dependency>
            <groupId>nl.rotterdam.nl-design-system</groupId>
            <artifactId>rotterdam-nlds-extensions-wicket</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.wicket</groupId>
            <artifactId>wicket-tester</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-database-spring-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Drop the Docker/Testcontainers-backed providers entirely: on macOS starting a
                     container triggers a TCC "access data from other apps" (Apple Events) prompt,
                     and it requires Docker Desktop to be installed and running. We use the native
                     Zonky provider instead (see embedded-postgres dependency below), which runs a
                     real postgres binary as a plain subprocess. -->
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>postgresql</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mysql</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mssqlserver</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mariadb</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Zonky provider: runs a real, natively-executed PostgreSQL binary for tests, no Docker required -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Default binaries only cover amd64; add arm64v8 explicitly for Apple Silicon Macs -->
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
