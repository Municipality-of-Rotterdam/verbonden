<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.rotterdam.verbonden</groupId>
        <artifactId>verbonden</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>verbonden-app-local</artifactId>
    <packaging>jar</packaging>

    <name>verbonden-app-local</name>
    <description>
        Uitvoerbaar Spring Boot-artefact van de Verbonden-applicatie, draait altijd op
        verbonden-remote-local (mock-adapters). Niet gepubliceerd op Maven Central.
    </description>

    <properties>
        <!-- Never publish this module: it has no distributionManagement. All modules
             (including this one) inherit the "release" profile from the parent pom,
             so during -Prelease it still gets signed/built with source+javadoc jars
             like core/remote-local, but this skip keeps it from being deployed. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>nl.rotterdam.verbonden</groupId>
            <artifactId>verbonden-core</artifactId>
        </dependency>
        <dependency>
            <groupId>nl.rotterdam.verbonden</groupId>
            <artifactId>verbonden-remote-local</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.apache.wicket</groupId>
            <artifactId>wicket-tester</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-database-spring-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Drop the Docker/Testcontainers-backed providers entirely: on macOS starting a
                     container triggers a TCC "access data from other apps" (Apple Events) prompt,
                     and it requires Docker Desktop to be installed and running. We use the native
                     Zonky provider instead (see embedded-postgres dependency below), which runs a
                     real postgres binary as a plain subprocess. -->
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>postgresql</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mysql</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mssqlserver</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mariadb</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Zonky provider: runs a real, natively-executed PostgreSQL binary for tests, no Docker required -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Default binaries only cover amd64; add arm64v8 explicitly for Apple Silicon Macs -->
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
