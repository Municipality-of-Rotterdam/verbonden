<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.rotterdam.verbonden</groupId>
        <artifactId>verbonden</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>verbonden-remote-local</artifactId>
    <packaging>jar</packaging>

    <name>verbonden-remote-local</name>
    <description>
        Mock-implementatie van de verbonden-core identity-SPI (mock-DigiD-inlogpagina en
        mock-persoonsgegevens) voor lokale ontwikkeling, en publieke referentie-implementatie
        voor wie een eigen adapter-module bouwt.
    </description>
    <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>

    <developers>
        <developer>
            <name>Gemeente Rotterdam - Mijnloket ontwikkelteam</name>
            <email>mijnloket_ontwikkelteam@Rotterdam.onmicrosoft.com</email>
            <organization>Gemeente Rotterdam</organization>
            <organizationUrl>https://www.rotterdam.nl</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Municipality-of-Rotterdam/verbonden.git</connection>
        <developerConnection>scm:git:git@github.com:Municipality-of-Rotterdam/verbonden.git</developerConnection>
        <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>nl.rotterdam.verbonden</groupId>
            <artifactId>verbonden-core</artifactId>
        </dependency>
    </dependencies>

    <!-- Only active with -Prelease (see release.yml / root pom.xml) so ordinary
         `mvnw verify` builds are unaffected. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
