<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.rotterdam.verbonden</groupId>
        <artifactId>verbonden</artifactId>
        <version>0.0.2-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>verbonden-remote-local</artifactId>
    <packaging>jar</packaging>

    <name>verbonden-remote-local</name>
    <description>
        Mock-implementatie van de verbonden-core identity-SPI (mock-DigiD-inlogpagina en
        mock-persoonsgegevens) voor lokale ontwikkeling, en publieke referentie-implementatie
        voor wie een eigen adapter-module bouwt.
    </description>
    <!-- Deliberately duplicated (not inherited) from the parent pom: Maven's default
         inheritance appends this module's artifactId to an inherited url/scm.* (e.g.
         ".../verbonden/verbonden-remote-local"), which is wrong here since every module
         lives at the same repo URL. The documented opt-out (child.*.inherit.append.path
         properties, either on parent or child) does not take effect on this project's
         Maven version (verified empirically, incl. in an isolated throwaway reactor),
         so an explicit, identical copy is the only reliable way to publish a correct
         url/scm to Maven Central. Keep this in sync with pom.xml/core/pom.xml if the
         repo URL ever changes. -->
    <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>

    <scm>
        <connection>scm:git:https://github.com/Municipality-of-Rotterdam/verbonden.git</connection>
        <developerConnection>scm:git:git@github.com:Municipality-of-Rotterdam/verbonden.git</developerConnection>
        <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>nl.rotterdam.verbonden</groupId>
            <artifactId>verbonden-core</artifactId>
        </dependency>
    </dependencies>

</project>
