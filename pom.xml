<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>nl.rotterdam.verbonden</groupId>
    <artifactId>verbonden</artifactId>
    <version>0.0.2-alpha</version>
    <packaging>pom</packaging>

    <name>verbonden</name>
    <description>Verbonden - Municipality of Rotterdam</description>

    <licenses>
        <license>
            <name>European Union Public Licence v. 1.2</name>
            <url>https://eupl.eu/1.2/en/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>

    <developers>
        <developer>
            <name>Gemeente Rotterdam - Mijnloket ontwikkelteam</name>
            <email>mijnloket_ontwikkelteam@Rotterdam.onmicrosoft.com</email>
            <organization>Gemeente Rotterdam</organization>
            <organizationUrl>https://www.rotterdam.nl</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Municipality-of-Rotterdam/verbonden.git</connection>
        <developerConnection>scm:git:git@github.com:Municipality-of-Rotterdam/verbonden.git</developerConnection>
        <url>https://github.com/Municipality-of-Rotterdam/verbonden</url>
    </scm>

    <modules>
        <module>core</module>
        <module>remote-local</module>
        <module>app-local</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <wicket.version>10.11.0</wicket.version>
        <wicket-stuff.version>10.10.0</wicket-stuff.version>
        <rotterdam-nlds.version>0.1.1</rotterdam-nlds.version>
        <wicket-webjars.version>4.0.14</wicket-webjars.version>
        <bootstrap.version>5.3.8</bootstrap.version>
        <!-- Pinned to match the PostgreSQL major version used by compose.yml -->
        <embedded-postgres-binaries.version>18.6.0</embedded-postgres-binaries.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Force Wicket 10.8.0 for all transitive dependencies -->
            <dependency>
                <groupId>org.apache.wicket</groupId>
                <artifactId>wicket-core</artifactId>
                <version>${wicket.version}</version>
            </dependency>

            <dependency>
                <groupId>org.wicketstuff</groupId>
                <artifactId>wicketstuff-minis</artifactId>
                <version>${wicket-stuff.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.wicket</groupId>
                <artifactId>wicket-tester</artifactId>
                <version>${wicket.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.28.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.wicket</groupId>
                <artifactId>wicket-request</artifactId>
                <version>${wicket.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.wicket</groupId>
                <artifactId>wicket-util</artifactId>
                <version>${wicket.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.wicket</groupId>
                <artifactId>wicket-extensions</artifactId>
                <version>${wicket.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.wicket</groupId>
                <artifactId>wicket-spring</artifactId>
                <version>${wicket.version}</version>
            </dependency>

            <!-- Rotterdam NL Design System Wicket components -->
            <dependency>
                <groupId>nl.rotterdam.nl-design-system</groupId>
                <artifactId>rotterdam-nlds-wicket</artifactId>
                <version>${rotterdam-nlds.version}</version>
            </dependency>
            <dependency>
                <groupId>nl.rotterdam.nl-design-system</groupId>
                <artifactId>rotterdam-nlds-css-wicket</artifactId>
                <version>${rotterdam-nlds.version}</version>
            </dependency>
            <dependency>
                <groupId>nl.rotterdam.nl-design-system</groupId>
                <artifactId>rotterdam-nlds-extensions-wicket</artifactId>
                <version>${rotterdam-nlds.version}</version>
            </dependency>

            <!-- Wicket Webjars integration -->
            <dependency>
                <groupId>de.agilecoders.wicket.webjars</groupId>
                <artifactId>wicket-webjars</artifactId>
                <version>${wicket-webjars.version}</version>
            </dependency>
            <!-- Bootstrap utilities CSS (via WebJars) -->
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>bootstrap</artifactId>
                <version>${bootstrap.version}</version>
            </dependency>

            <!-- Phone number validation -->
            <dependency>
                <groupId>com.googlecode.libphonenumber</groupId>
                <artifactId>libphonenumber</artifactId>
                <version>9.0.38</version>
            </dependency>

            <!-- Email address validation -->
            <dependency>
                <groupId>commons-validator</groupId>
                <artifactId>commons-validator</artifactId>
                <version>1.11.0</version>
            </dependency>

            <!-- ZXing QR code generation -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>3.5.4</version>
            </dependency>

            <!-- Jsoup for web scraping (BABS import from rotterdam.nl) -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>1.23.2</version>
            </dependency>

            <!-- Apache POI for xlsx import -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>5.5.1</version>
            </dependency>

            <!-- Zonky embedded-database-spring-test: real Postgres binaries as a subprocess, no Docker required -->
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-database-spring-test</artifactId>
                <version>2.8.0</version>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>2.2.2</version>
            </dependency>
            <!-- Selects which native postgres binaries the Zonky embedded-postgres provider downloads/uses -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Reactor modules -->
            <dependency>
                <groupId>nl.rotterdam.verbonden</groupId>
                <artifactId>verbonden-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>nl.rotterdam.verbonden</groupId>
                <artifactId>verbonden-remote-local</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Include Wicket HTML markup files co-located with Java classes -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.html</include>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.css</include>
                </includes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>true</autoPublish>
                        <waitUntil>published</waitUntil>
                        <deploymentName>verbonden ${project.version}</deploymentName>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <!-- Release POM metadata requires attached javadoc jars; this codebase's
                             Javadoc comments aren't doclint-clean, so don't fail the release build on that. -->
                        <doclint>none</doclint>
                        <failOnError>false</failOnError>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- The "release" profile activates signing + Central publishing, and is only
         enabled via -Prelease during the release workflow (see .github/workflows/release.yml)
         — never during a normal `mvnw verify`, which has no GPG key/Sonatype credentials
         available and must keep working unchanged for ordinary CI builds.
         It's declared once here and inherited by every module, including app-local.
         app-local is kept out of publishing simply via its own <maven.deploy.skip>true</maven.deploy.skip>
         (see app-local/pom.xml), which skips the deploy step there; it still gets
         signed/built with source+javadoc jars like the other modules during -Prelease. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
